    <script>
        document.addEventListener('contextmenu', function(e) {
            e.preventDefault();
        });

        document.addEventListener('keydown', function(e) {
            if (e.keyCode == 123 ||
                (e.ctrlKey && e.shiftKey && e.keyCode == 73) ||
                (e.ctrlKey && e.shiftKey && e.keyCode == 74) ||
                (e.ctrlKey && e.keyCode == 85)) {
                e.preventDefault();
            }
        });

        const appName = document.getElementById('appName');
        const iconGlow = document.getElementById('iconGlow');
        const iconOuter = document.getElementById('iconOuter');
        const iconEmoji = document.getElementById('iconEmoji');
        const tagline = document.getElementById('tagline');
        const slogan = document.getElementById('slogan');
        const taskDesc = document.getElementById('taskDesc');
        const loading = document.getElementById('loading');
        const version = document.getElementById('version');
        const flash = document.getElementById('flash');
        const popupOverlay = document.getElementById('popupOverlay');

        // ✅ FIXED: Slogans now describe actual tasks — no income claims
        const slogans = [
            "Answer AI surveys task",
            "Rate, label & categorize AI content",
            "Complete task packs ",
            "Real AI training work"
        ];

        let currentSloganIndex = 0;

        function typeText(element, text, speed = 25) {
            return new Promise((resolve) => {
                let index = 0;
                element.textContent = '';
                const interval = setInterval(() => {
                    if (index < text.length) {
                        element.textContent += text.charAt(index);
                        index++;
                    } else {
                        clearInterval(interval);
                        resolve();
                    }
                }, speed);
            });
        }

        function fadeIn(element, duration = 300) {
            return new Promise((resolve) => {
                element.style.transition = `opacity ${duration}ms ease, transform ${duration}ms ease`;
                element.style.opacity = '1';
                element.style.transform = 'translateY(0)';
                setTimeout(resolve, duration);
            });
        }

        function scaleIn(element, duration = 300) {
            return new Promise((resolve) => {
                element.style.transition = `all ${duration}ms cubic-bezier(0.34, 1.56, 0.64, 1)`;
                element.style.transform = 'scale(1)';
                element.style.opacity = '1';
                setTimeout(resolve, duration);
            });
        }

        async function rotateSlogans() {
            while (currentSloganIndex < slogans.length) {
                await typeText(slogan, slogans[currentSloganIndex]);
                await new Promise(resolve => setTimeout(resolve, 500));

                slogan.style.transition = 'opacity 200ms ease';
                slogan.style.opacity = '0';
                await new Promise(resolve => setTimeout(resolve, 200));

                currentSloganIndex++;

                if (currentSloganIndex < slogans.length) {
                    slogan.style.opacity = '1';
                }
            }
        }

        async function animateSplash() {
            flash.style.transition = 'opacity 50ms ease';
            flash.style.opacity = '0.6';
            await new Promise(resolve => setTimeout(resolve, 50));
            flash.style.opacity = '0';

            await new Promise(resolve => setTimeout(resolve, 100));

            await typeText(appName, 'REMO-TASK', 15);
            await fadeIn(appName, 150);

            await new Promise(resolve => setTimeout(resolve, 100));

            await scaleIn(iconGlow, 150);
            await scaleIn(iconOuter, 200);

            iconEmoji.style.fontSize = '22px';
            await new Promise(resolve => setTimeout(resolve, 75));
            iconEmoji.style.fontSize = '18px';

            await new Promise(resolve => setTimeout(resolve, 100));

            await fadeIn(tagline, 150);

            await new Promise(resolve => setTimeout(resolve, 50));

            rotateSlogans();

            await new Promise(resolve => setTimeout(resolve, 150));

            await fadeIn(loading, 150);

            // ✅ Show task description alongside spinner
            taskDesc.style.transition = 'opacity 300ms ease';
            taskDesc.style.opacity = '1';

            await new Promise(resolve => setTimeout(resolve, 100));

            await fadeIn(version, 150);

            await new Promise(resolve => setTimeout(resolve, 1500));

            flash.style.transition = 'opacity 100ms ease';
            flash.style.opacity = '1';
            await new Promise(resolve => setTimeout(resolve, 100));

            navigateToNextScreen();
        }

        function navigateToNextScreen() {
            const hasSignup = localStorage.getItem('signuplist');
            const hasBonusClaimed = localStorage.getItem('bonus_claimed');
            const hasBoughtAccount = localStorage.getItem('boughtaccount');

            if (hasSignup && hasBonusClaimed && hasBoughtAccount) {
                window.location.href = 'dashboard.html';
            } else if (hasSignup && hasBonusClaimed && !hasBoughtAccount) {
                window.location.href = 'account-purchase.html';
            } else if (hasSignup && !hasBonusClaimed) {
                window.location.href = 'onboarding-quiz.html';
            } else {
                window.location.href = 'welcome.html';
            }
        }

        function handleBuyNow() {
            window.location.href = 'account-purchase.html';
            closeBuyAccountPopup();
        }

        function handleLater() {
            popupOverlay.classList.remove('active');
        }

        function closeBuyAccountPopup() {
            popupOverlay.classList.remove('active');
        }

        window.addEventListener('load', animateSplash);
    </script>
